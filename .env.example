# EmailJS (https://www.emailjs.com) — used by the booking form and fleet inquiry form.
# Create a free EmailJS account, add an Email Service, and create two templates
# (one for service bookings, one for fleet inquiries). All three keys below are
# public/client-side keys — EmailJS is designed for this.

NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_FLEET_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Used in metadata, JSON-LD schema, and sitemap.xml/robots.txt generation.
# Set this to your real production domain once you have one.
NEXT_PUBLIC_SITE_URL=https://www.sandhumotors.in
